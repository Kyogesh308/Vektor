# =============================================================================
# Vektor Environment Configuration Template (.env)
# =============================================================================
# Copy this file to .env before starting containers:
#   cp .env.example .env

# --- Database Storage ---
# Inside Docker, /data is mounted to the persistent named volume 'vektor_data'
VEKTOR_DATA_DIR=/data

# --- Local Ollama Inference (Optional) ---
# Default container address inside Docker network
OLLAMA_HOST=http://ollama:11434
# If running Ollama natively on host machine (outside Docker):
# OLLAMA_HOST=http://host.docker.internal:11434

# --- Cloud LLM API Keys (Optional - for instant zero-setup RAG Q&A) ---
# Provide any ONE of these keys to enable cloud LLM answers:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Service Ports ---
PORT=8000
UI_PORT=8501
