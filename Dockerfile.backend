# ============================================================
# Dockerfile.backend — Vektor API Server
# ============================================================
# Stage 1: builder — install dependencies into a clean venv
FROM python:3.12-slim AS builder

WORKDIR /build

# System deps needed to compile numpy/h5py wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        libhdf5-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency definitions first (layer-cache friendly)
COPY pyproject.toml requirements.txt ./
COPY src/ src/

# Install dependencies into /opt/venv
RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install --upgrade pip && \
    /opt/venv/bin/pip install -r requirements.txt && \
    /opt/venv/bin/pip install --no-deps -e .

# ============================================================
# Stage 2: runtime — lean image, just copy venv + source
FROM python:3.12-slim AS runtime

WORKDIR /app

# Runtime system deps (curl for healthchecks)
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Bring in the pre-built venv
COPY --from=builder /opt/venv /opt/venv

# Copy application source
COPY src/ src/
COPY demo/ demo/
COPY pyproject.toml .

# Make the venv the active Python
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH="/app/src:/app"

# Persistent data volume mount point
VOLUME ["/data"]

# Expose the API port
EXPOSE 8000

# Health-check — the /health endpoint is defined in health.py
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default: start the Vektor API server, storing data in /data
CMD ["python", "-m", "uvicorn", "vektor.api.app:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--log-level", "info"]
